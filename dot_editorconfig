# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true

# 2 space indentation
[*.{yml,yaml}]
indent_size = 2

# Tab indentation (no size specified)
[Makefile]
indent_style = tab
