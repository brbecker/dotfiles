# Force all github.com HTTPS URLs to SSH
[core]
    # autocrlf: Use input for Linux, true on Windows
    autocrlf = true
    editor = code --wait
    excludesfile = ~/.config/git/.gitignore

[checkout]
    defaultRemote = origin

[credential]
    helper = manager
# From WSL2 Ubuntu
# [credential "https://github.com"]
#     helper = 
#     helper = !/snap/gh/751/gh auth git-credential
# [credential "https://gist.github.com"]
#     helper = 
#     helper = !/snap/gh/751/gh auth git-credential

[diff]
    tool = vscode
[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE

[merge]
    ff = no
    tool = code
[mergetool "code"]
    cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED

[pull]
    ff = yes

[url "git@github.com:"]
    insteadOf = https://github.com/

# Personal github account
[url "git@brbecker-github:brbecker/"]
    insteadOf = git@github.com:brbecker/
    insteadOf = https://github.com/brbecker/

# Force https for Bitbucket URLs
[url "https://user-hjzHUfB4QVaFRYlxwYRqvA@bitbucket.org/blueshieldca/"]
    insteadOf = git@bitbucket.org:blueshieldca/
    # insteadOf = https://user-hjzHUfB4QVaFRYlxwYRqvA@bitbucket.org/user-hjzhufb4qvafrylxwyrqva
[url "https://user-hjzHUfB4QVaFRYlxwYRqvA@bitbucket.org/user-hjzhufb4qvafrylxwyrqva/"]
    insteadOf = git@bitbucket.org:user-hjzhufb4qvafrylxwyrqva/
    # insteadOf = https://user-hjzHUfB4QVaFRYlxwYRqvA@bitbucket.org/user-hjzhufb4qvafrylxwyrqva

# Most of the user configuration set via the includeIfs below
[user]
    # Don't let git guess user.name or user.email
    useConfigOnly = true

###  
# Conditional include stuff. KEEP AT END so they can override anything set
# above. NOTE: the remote.*.url conditionals ignore the "insteadOf" rewrites
# defined earlier, so we have to use the original URL here, not the rewritten
# one.
###

# Configs for work Bitbucket repos (in the https URL, note the username is mixed
# case, but the path is lowercase)
[includeIf "hasconfig:remote.*.url:git@bitbucket.org:blueshieldca/**"]
    path = ~/.config/git/stellarus.gitconfig
[includeIf "hasconfig:remote.*.url:https://user-hjzHUfB4QVaFRYlxwYRqvA@bitbucket.org/blueshieldca/**"]
    path = ~/.config/git/stellarus.gitconfig
[includeIf "hasconfig:remote.*.url:git@bitbucket.org:user-hjzhufb4qvafrylxwyrqva/**"]
    path = ~/.config/git/stellarus.gitconfig
[includeIf "hasconfig:remote.*.url:https://user-hjzHUfB4QVaFRYlxwYRqvA@bitbucket.org/user-hjzhufb4qvafrylxwyrqva/**"]
    path = ~/.config/git/stellarus.gitconfig

# Configs for personal github repos
[includeIf "hasconfig:remote.*.url:git@brbecker-github:brbecker/**"]
    path = ~/.config/git/brbecker-github.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:brbecker/**"]
    path = ~/.config/git/brbecker-github.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/brbecker/**"]
    path = ~/.config/git/brbecker-github.gitconfig

# OS-specific configs
[includeIf "gitdir:C:"]
    path = ~/.config/git/windows.gitconfig
[includeIf "gitdir:/home"]
    path = ~/.config/git/linux.gitconfig
