    # insteadOf = https://user-hjzHUfB4QVaFRYlxwYRqvA@bitbucket.org/user-hjzhufb4qvafrylxwyrqva

[core]
    # autocrlf: Use input for Linux, true on Windows
    autocrlf = true
    editor = code --wait
    excludesfile = ~/.config/git/.gitignore

[checkout]
    defaultRemote = origin

[pull]
    ff = yes

# Most of the user configuration set via the includeIfs below
[user]
    # Don't let git guess user.name or user.email
    useConfigOnly = true

[diff]
    tool = vscode
[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE

[merge]
    ff = no
    tool = code
[mergetool "code"]
    cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED

[credential]
    helper = manager
