# Global defaults
Host *
  # Server keep alive messages
  ServerAliveCountMax=3
  ServerAliveInterval=15

  # Forwarding SSH Agent can constitute a security issue if the remote host is
  # compromised. Try not to use it.
  # ForwardAgent    yes

  # This setting will eliminate the remote banner, but allow normal errors.
  LogLevel        error

  # Enable SSH multiplexing.
  # Needed for VSC SSH Agent support?
  # ControlMaster auto
  # ControlPath  ~/.ssh/sockets/%r@%h-%p
  # ControlPersist  600

##### Host specific entries here

