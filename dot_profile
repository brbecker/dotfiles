# On Windows, if Microsoft's OpenSSH client is installed, prefer it.
contains() { case $2 in *"$1"*) true;; *) false;; esac; }
if contains Windows "$OS"; then
    __WIN_SSH_DIR="/c/Windows/System32/OpenSSH"
    if [ -d "${__WIN_SSH_DIR}" ] && [ -x "${__WIN_SSH_DIR}/ssh.exe" ]; then
        if ! contains "${__WIN_SSH_DIR}" "$(which ssh)"; then
            PATH="${__WIN_SSH_DIR}:${PATH}"
        fi
    # else try ssh-pageant?
    fi
    unset __WIN_SSH_DIR
fi

